<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorSecondary">@color/colorPrimary</item>
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="coordinatorLayoutStyle">@style/Widget.Support.CoordinatorLayout</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.MyApp.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.MyApp.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.MyApp.LargeComponent</item>
        <item name="verticalRecyclerViewStyle">@style/VerticalRecyclerView</item>
        <item name="android:windowSoftInputMode">adjustPan</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="navigationViewStyle">@style/Widget.MyApp.NavigationView</item>
    </style>

    <!-- 抽屉导航：26dp 柔和彩色块图标、16sp 文字、52dp 行高、选中浅蓝胶囊底 -->
    <style name="Widget.MyApp.NavigationView" parent="Widget.MaterialComponents.NavigationView">
        <item name="itemIconSize">26dp</item>
        <item name="itemIconTint">@null</item>
        <item name="itemTextAppearanceInactive">@style/NavMenuItemTextInactive</item>
        <item name="itemTextAppearanceActive">@style/NavMenuItemTextActive</item>
        <item name="itemBackground">@drawable/nav_item_bg</item>
        <item name="android:listPreferredItemHeight">52dp</item>
        <item name="android:listPreferredItemHeightSmall">52dp</item>
    </style>

    <!-- 卡片风格圆角 16dp -->
    <style name="ShapeAppearance.MyApp.SmallComponent" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.MyApp.MediumComponent" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.MyApp.LargeComponent" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- AppBar 主色：深棕色 -->
    <style name="AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:windowBackground">@color/colorPrimary</item>
    </style>

    <style name="SplashTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:background">@drawable/splash</item>
    </style>

    <style name="ButtonBackground">
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>

    <!-- 对话框按钮 -->
    <style name="DialogButtonStyle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="cornerRadius">24dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <!-- 导入弹窗：主推按钮（主色实心白字） -->
    <style name="ImportPrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:layout_marginEnd">0dp</item>
    </style>

    <!-- 导入弹窗：次要按钮（浅灰实底 + 深灰近黑字，无描边，避免半透明 tint 渲染出白线） -->
    <style name="ImportSecondaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#1C1C1E</item>
        <item name="backgroundTint">#F2F2F7</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:layout_marginEnd">0dp</item>
    </style>

    <attr name="verticalRecyclerViewStyle" format="reference" />

    <style name="VerticalRecyclerView" parent="android:Widget">
        <item name="android:scrollbars">vertical</item>
    </style>

    <style name="MainHeadDetailText">
        <item name="android:textSize">12sp</item>
        <item name="android:alpha">0.65</item>
    </style>

    <!-- 抽屉菜单文字：16sp，未选 #1C1C1E，选中主色 -->
    <style name="NavMenuItemTextInactive" parent="TextAppearance.AppCompat.Body2">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="NavMenuItemTextActive" parent="TextAppearance.AppCompat.Body2">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorPrimary</item>
    </style>

    <!-- 抽屉头部应用图标：12dp 圆角 -->
    <style name="NavHeaderIcon">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- 设置页分组标题：13sp 副文字色加粗，与卡片左缘对齐，上20下8 -->
    <style name="settings_subtitle">
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- 设置项：点击水波纹，单行高 56dp -->
    <style name="settings_item_ll">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_width">match_parent</item>
    </style>

    <style name="settings_item_ll_with_tips">
        <item name="android:orientation">vertical</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_width">match_parent</item>
    </style>

    <!-- 设置项主标题：15sp -->
    <style name="settings_item_tv_main">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="settings_item_tv_title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:gravity">bottom</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- 设置项副标题：灰色 12sp -->
    <style name="settings_item_tv_tip">
        <item name="android:textSize">12sp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:gravity">top</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_weight">0.8</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="ScheduleHeaderStyle">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@color/nodeIndex</item>
    </style>

    <style name="IconTextViewStyle">
        <item name="android:textSize">24sp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">@font/iconfont</item>
    </style>

</resources>
