<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_today_card_bg">

    <!-- header：左侧标题/副标，右侧操作图标 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_headerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今日课程"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1C1C1E" />

            <TextView
                android:id="@+id/tv_headerSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="加载中…"
                android:textSize="11sp"
                android:textColor="#8E8E93" />
        </LinearLayout>

        <!--
          头部功能区（v153 定稿）：
            顺序 = [翻页箭头] [打开课表] [Logo]

          · 排列思路：
            a) 「打开课表」胶囊与「箭头」都是可点操作，聚在中间偏左成一簇，
               手指从右侧滑过来先碰到操作区，符合"操作聚簇"的习惯。
            b) Logo 是**纯装饰、不可点**的品牌符号，放最右收边，作为整行的
               视觉终止点；它的存在不打断操作区，也不与标题争夺左侧识别位。
            c) 标题在左（识别）→ 操作居中（箭头 / 打开课表）→ 品牌收尾在右，
               三段职责清晰，横向节奏是"重 → 中 → 轻"。

          · 原 iv_refresh 已删除（用户要求）：刷新由闹钟 + 30 分钟兜底 + 点击卡片进行
          · tv_openApp 取代原卡片底部的 tv_emptyAction 大按钮，改为头部小胶囊，
            这样空态时底部整块空间腾出来给提示短语放大使用
        -->
        <ImageView
            android:id="@+id/iv_next"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="3dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_next" />

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="3dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_back"
            android:visibility="gone" />

        <!-- 「打开课表」胶囊（v153）：夹在箭头与 Logo 之间。
             marginEnd 8dp 用于与右侧 Logo 拉开距离，避免胶囊边缘与小鹿鹿角粘连。 -->
        <TextView
            android:id="@+id/tv_openApp"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:maxLines="1"
            android:text="打开课表"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/widget_open_app_bg" />

        <!-- 品牌 Logo（v148 矢量小鹿 / v153 回到最右收边）：纯装饰，无点击事件。
             尺寸 26×26dp：小鹿是"鹿角在上、身体在下"的竖直构图，24 单位视口里
             图形本身只占中间约 21 单位（四周留了安全边距防裁切），所以 ImageView
             要给到 26dp，鹿角与眼窝这些细节才认得出。
             实测：再小（22dp）鹿角会糊成一团；再大（30dp+）会挤压左侧的胶囊与箭头，
             卡片头部视觉失衡。
             **右侧 marginEnd=6dp 是刻意留的**：卡片右上角是圆角（radius 24dp），
             卡片 padding 只有 10dp，若不额外留白，小鹿会正好落在圆角的弧形收窄区里，
             视觉上像"顶出框"（实测 2dp 不够、6dp 才明显好转）。
             右侧一共留出 10dp(padding) + 6dp(margin) = 16dp 呼吸位，与圆角弧线错开。
             左侧不设 margin：左边距由「打开课表」胶囊的 marginEnd 提供。
             **绝不要对这个 ImageView 调 setColorFilter**，否则整只鹿会变成单色灰块。 -->
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_logo" />
    </LinearLayout>

