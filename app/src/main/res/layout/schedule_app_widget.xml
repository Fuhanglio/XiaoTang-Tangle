                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:id="@+id/wrow_bar_2"
                    android:layout_width="3dp"
                    android:layout_height="14dp"
                    android:scaleType="fitXY"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_row_bar" />

                <TextView
                    android:id="@+id/wrow_label_2"
                    android:layout_width="62dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#8E8E93" />

                <TextView
                    android:id="@+id/wrow_courses_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="12sp"
                    android:textColor="#1C1C1E" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/wrow_3"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="2dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/wrow_bg_3"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:scaleType="fitXY"
                android:contentDescription="@null"
                android:src="@drawable/widget_row_capsule" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:id="@+id/wrow_bar_3"
                    android:layout_width="3dp"
                    android:layout_height="14dp"
                    android:scaleType="fitXY"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_row_bar" />

                <TextView
                    android:id="@+id/wrow_label_3"
                    android:layout_width="62dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#8E8E93" />

                <TextView
                    android:id="@+id/wrow_courses_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="12sp"
                    android:textColor="#1C1C1E" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/wrow_4"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="2dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/wrow_bg_4"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:scaleType="fitXY"
                android:contentDescription="@null"
                android:src="@drawable/widget_row_capsule" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:id="@+id/wrow_bar_4"
                    android:layout_width="3dp"
                    android:layout_height="14dp"
                    android:scaleType="fitXY"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_row_bar" />

                <TextView
                    android:id="@+id/wrow_label_4"
                    android:layout_width="62dp"
