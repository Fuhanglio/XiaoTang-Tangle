                <ImageView
                    android:id="@+id/wrow_bar_6"
                    android:layout_width="3dp"
                    android:layout_height="14dp"
                    android:scaleType="fitXY"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_row_bar" />

                <TextView
                    android:id="@+id/wrow_label_6"
