                    android:textColor="#1C1C1E" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/wrow_5"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="2dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/wrow_bg_5"
                android:layout_width="match_parent"
